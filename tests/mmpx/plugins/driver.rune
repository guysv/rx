// Test driver: stamps the current selection, upscaled 2x through
// mmpx::render_pass, to the right of the selection.
pub fn init(rx) {
    rx.register_command("stamp", [], "Stamp selection via mmpx", stamp);
    #{ pending: None }
}

pub fn stamp(state, rx, args) {
    let sel = rx.selection();
    if sel.is_none() {
        return;
    }
    let (x1, y1, x2, y2) = sel.unwrap();
    let view_id = rx.active_view_id();
    let r = rx::rect(x1 as f64, y1 as f64, x2 as f64, y2 as f64);
    let pixels = rx.view_pixels(view_id, r);
    if pixels.is_none() {
        return;
    }
    let w = if x2 > x1 { x2 - x1 } else { x1 - x2 };
    let h = if y2 > y1 { y2 - y1 } else { y1 - y2 };
    let src = rx.create_texture(w, h).unwrap();
    src.upload(pixels.unwrap());

    let dx = (if x2 > x1 { x2 } else { x1 } + 4) as f64;
    let dy = (if y1 < y2 { y1 } else { y2 }) as f64;
    let dst = rx::rect(dx, dy, dx + 2.0 * w as f64, dy + 2.0 * h as f64);

    state.pending = Some(#{ view_id, src, dst });
    rx.touch_view(view_id);
}

pub fn shade(state, rx, encoder) {
    if state.pending.is_none() {
        return;
    }
    let job = state.pending.unwrap();
    state.pending = None;

    let view = None;
    for v in rx.views() {
        if v.id == job.view_id {
            view = Some(v);
        }
    }
    let view = view.unwrap();

    rx.call_plugin(
        "mmpx",
        "render_pass",
        [encoder, rx::mat4_identity(), job.view_id, job.src, job.dst, view.width, view.height],
    )
    .unwrap();
}
