// animation-mode: per-view playback orders, controlled by
// :set animation/mode = forward | reverse | ping-pong.
// The host owns the animation clock and delay; successful changes are silent.

pub fn init(rx) {
    rx.declare_setting("animation/mode", "forward");
    #{ last_mode: "forward", views: [] }
}

fn apply(rx, view, mode) {
    if mode == "forward" {
        rx.clear_animation_sequence(view.id);
    } else if mode == "reverse" {
        let sequence = [];
        let frame = view.frames;
        while frame > 0 {
            frame -= 1;
            sequence.push(frame);
        }
        rx.set_animation_sequence(view.id, sequence);
    } else {
        let sequence = [];
        for frame in 0..view.frames {
            sequence.push(frame);
        }
        // Endpoints occur once per cycle: 0, 1, 2, 3, 2, 1.
        let frame = view.frames - 2;
        while frame > 0 {
            sequence.push(frame);
            frame -= 1;
        }
        rx.set_animation_sequence(view.id, sequence);
    }
}

pub fn update(state, rx) {
    let requested = rx.setting("animation/mode").to_lowercase();
    if requested == "pingpong" { requested = "ping-pong"; }
    if requested != "forward" && requested != "reverse" && requested != "ping-pong" {
        rx.set_setting("animation/mode", state.last_mode.clone());
        rx.message("Invalid animation/mode; use forward, reverse, or ping-pong");
        return;
    }

    for view in rx.views() {
        if view.id != rx.active_view_id() { continue; }
        let entry = ();
        let found = false;
        for saved in state.views {
            if saved.id == view.id { entry = saved; found = true; }
        }
        if !found {
            entry = #{ id: view.id, mode: "forward", frames: -1 };
            state.views.push(entry);
        }
        // An explicit setting change applies to the active view. Otherwise,
        // switching views restores that view's setting without changing it.
        let mode = if requested != state.last_mode { requested } else { entry.mode };
        if mode != entry.mode || view.frames != entry.frames {
            apply(rx, view, mode);
            entry.mode = mode;
            entry.frames = view.frames;
        }
        rx.set_setting("animation/mode", entry.mode.clone());
        state.last_mode = entry.mode;
        return;
    }
}

pub fn view_removed(state, rx, id) {
    let remaining = [];
    for entry in state.views {
        if entry.id != id { remaining.push(entry); }
    }
    state.views = remaining;
}
