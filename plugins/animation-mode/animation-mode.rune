// animation-mode: per-view playback orders for sprite strips.
//
// The host still owns the global animation clock and delay. This plugin only
// selects the order in which the active view's frames are visited.

pub fn init(rx) {
    rx.register_command(
        "animation-mode",
        ["str"],
        "Set active-view playback: forward, reverse, or ping-pong",
        animation_mode,
    );
    #{}
}

fn active_view(rx) {
    let id = rx.active_view_id();
    for view in rx.views() {
        if view.id == id {
            return Some(view);
        }
    }
    None
}

fn animation_mode(state, rx, args) {
    let view = active_view(rx);
    if view.is_none() {
        rx.message("No active view");
        return;
    }
    let view = view.unwrap();
    let mode = args[0].to_lowercase();

    if mode == "forward" {
        rx.clear_animation_sequence(view.id);
    } else if mode == "reverse" {
        let sequence = [];
        let frame = view.frames;
        while frame > 0 {
            frame -= 1;
            sequence.push(frame);
        }
        rx.set_animation_sequence(view.id, sequence);
    } else if mode == "ping-pong" || mode == "pingpong" {
        let sequence = [];
        for frame in 0..view.frames {
            sequence.push(frame);
        }
        // Endpoints occur once per cycle: 0, 1, 2, 3, 2, 1.
        let frame = view.frames - 2;
        while frame > 0 {
            sequence.push(frame);
            frame -= 1;
        }
        rx.set_animation_sequence(view.id, sequence);
    } else {
        rx.message(`Unknown animation mode '${mode}'; use forward, reverse, or ping-pong`);
        return;
    }

    rx.message(`Animation mode: ${mode}`);
}
