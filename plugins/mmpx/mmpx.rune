// mmpx: MMPX x2 upscale render pass (Rune port of mmpx.rxx; the WGSL
// is unchanged from master).
//
// An interface plugin: exports `render_pass` with the meta-plugin
// calling convention. The destination rect must be exactly 2x the
// source. Texture targets are cleared (intermediate x2 chains); view
// targets are loaded.

pub fn init(rx) {
    let wgsl = rx.read_file("mmpx.wgsl").unwrap();
    let shader = rx.create_shader(wgsl).unwrap();
    let pipeline = rx.create_render_pipeline(shader, "vs_main", "fs_mmpx", true).unwrap();
    rx.export("render_pass", render_pass);
    #{ pipeline }
}

pub fn render_pass(state, rx, args) {
    let encoder = args[0];
    let transform = args[1];
    let target = args[2];
    let source = args[3];
    let dst = args[4];
    let ortho_w = args[5];
    let ortho_h = args[6];

    let tbg = rx.create_transform_bind_group(ortho_w, ortho_h, transform).unwrap();
    let sbg = rx.create_texture_bind_group(source).unwrap();
    let verts = rx.create_sprite_vertices(source, dst, rx::rgb(255, 255, 255), 1.0).unwrap();

    let pass = if target is i64 {
        encoder.begin_view_pass("mmpx", target, "load").unwrap()
    } else {
        encoder.begin_render_pass("mmpx", target, "clear").unwrap()
    };
    pass.set_pipeline(state.pipeline).unwrap();
    pass.set_bind_group(0, tbg).unwrap();
    pass.set_bind_group(1, sbg).unwrap();
    pass.set_vertex_buffer(0, verts).unwrap();
    pass.draw(verts.count(), 1).unwrap();
}
