// cleanedge: cleanEdge upscale/rotation render pass (Rune port of
// cleanedge.rxx; the WGSL is unchanged from master).
//
// An interface plugin: it has no commands or hooks of its own. It
// exports `render_pass` for consumers (e.g. rotate-scale) to call:
//
//   rx.call_plugin("cleanedge", "render_pass",
//       [encoder, transform, target, source, dst, ortho_w, ortho_h])
//
// `target` is a texture, or a view id to paint into a view's layer.

pub fn init(rx) {
    let wgsl = rx.read_file("cleanedge.wgsl").unwrap();
    let shader = rx.create_shader(wgsl).unwrap();
    let pipeline = rx.create_render_pipeline(shader, "vs_main", "fs_main", true).unwrap();
    rx.export("render_pass", render_pass);
    #{ pipeline }
}

pub fn render_pass(state, rx, args) {
    let encoder = args[0];
    let transform = args[1];
    let target = args[2];
    let source = args[3];
    let dst = args[4];
    let ortho_w = args[5];
    let ortho_h = args[6];

    let tbg = rx.create_transform_bind_group(ortho_w, ortho_h, transform).unwrap();
    let sbg = rx.create_texture_bind_group(source).unwrap();
    let verts = rx.create_sprite_vertices(source, dst, rx::rgb(255, 255, 255), 1.0).unwrap();

    let pass = if target is i64 {
        encoder.begin_view_pass("cleanedge", target, "load").unwrap()
    } else {
        encoder.begin_render_pass("cleanedge", target, "load").unwrap()
    };
    pass.set_pipeline(state.pipeline).unwrap();
    pass.set_bind_group(0, tbg).unwrap();
    pass.set_bind_group(1, sbg).unwrap();
    pass.set_vertex_buffer(0, verts).unwrap();
    pass.draw(verts.count(), 1).unwrap();
}
